    "fastify-raw-body": "^4.3.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.12.0",
    "bcryptjs": "^2.4.3",
    "dockerode": "^4.0.2",

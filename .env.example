# =============================================================================
# VPS LATAM Cloud — Variables de entorno
# Copia este archivo como .env y completa los valores
# =============================================================================

# ── General ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# Dominio base (sin www, sin https)
BASE_DOMAIN=vpslatam.cloud

# Email para Let's Encrypt (avisos de expiración)
ACME_EMAIL=admin@vpslatam.cloud

# URL del repo git para auto-deploy (usado en deploy-production.sh)
REPO_URL=https://github.com/tu-usuario/vpslatam.git

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=vpslatam
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_PASSWORD_SEGURA_32CHARS

# Construida automáticamente en docker-compose, pero útil para dev local:
DATABASE_URL=postgresql://vpslatam:CAMBIA_ESTO_POR_PASSWORD_SEGURA_32CHARS@localhost:5432/vpslatam

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=REEMPLAZA_CON_64_CARACTERES_HEX_RANDOM_1111111111111111111111111111
JWT_REFRESH_SECRET=REEMPLAZA_CON_64_CARACTERES_HEX_RANDOM_2222222222222222222222222222

# ── Encryption (env vars de usuarios) ────────────────────────────────────────
# Generar con: openssl rand -hex 32  (DEBE ser exactamente 64 chars hex = 32 bytes)
ENCRYPTION_KEY=REEMPLAZA_CON_64_CARACTERES_HEX_RANDOM_3333333333333333333333333333

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Crear en: https://github.com/settings/applications/new
# Homepage URL: https://vpslatam.cloud
# Callback URL: https://api.vpslatam.cloud/api/auth/github/callback
GITHUB_CLIENT_ID=Iv1.XXXXXXXXXXXX
GITHUB_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Secret para validar webhooks de GitHub
# Generar con: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Traefik Dashboard ─────────────────────────────────────────────────────────
# Generar con: htpasswd -nb admin TU_PASSWORD
# (instalar con: apt install apache2-utils)
TRAEFIK_DASHBOARD_AUTH=admin:$apr1$XXXX$XXXX

# ── Stripe (opcional para MVP — puedes activar después) ───────────────────────
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX

# IDs de precios en Stripe (crear en Products > Add product)
STRIPE_PRICE_STARTER=price_XXXXXXXXXXXX
STRIPE_PRICE_PRO=price_XXXXXXXXXXXX
STRIPE_PRICE_BUSINESS=price_XXXXXXXXXXXX

# ── Mercado Pago (opcional) ───────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXX

# ── Email (Resend — gratis hasta 3000/mes) ────────────────────────────────────
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXX
EMAIL_FROM=noreply@vpslatam.cloud

# ── Límites de rate ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
